      "scopes": ["contract.sign"],
      "expect": "block",
      "failing_check": "sponsor_title_current"
    },
    {
      "id": "junior_sponsor",
      "story": "A backend engineer tries to authorise an agent to sign contracts.",
      "sponsor": {"name": "Charish Anumukonda", "profile_url": "https://www.linkedin.com/in/charish-anumukonda-80b459140", "company": "SpotDraft", "company_domain": "spotdraft.com", "title": "Backend Engineer"},
      "scopes": ["contract.sign"],
      "expect": "block",
      "failing_check": "sponsor_can_grant_scope"
