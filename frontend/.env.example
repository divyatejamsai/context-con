# FastAPI backend. Live mode POSTs to $NEXT_PUBLIC_API_URL/api/run
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: an onboarded agent id (backend/scripts/onboard_sourced.py). Live runs then go to
# /api/agents/{id}/run: passport check first, Send Guard on every shortlisted draft.
NEXT_PUBLIC_AGENT_ID=
# live (default) | replay (stream a recorded fixture, no backend)
NEXT_PUBLIC_DEFAULT_MODE=live
# Optional: absolute path to a run.jsonl for replay mode. Empty = frontend/fixtures/run.jsonl, then ../fixtures/run.jsonl
FIXTURE_PATH=
# Optional: address the Next server uses to reach the backend for login checks (default NEXT_PUBLIC_API_URL)
AUTH_API_URL=
