CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
CRUSTDATA_BASE_URL=https://api.crustdata.com
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
CRUSTDATA_MODE=live          # live | cache | replay | dev (synthetic, no network)
LLM_MODE=live                # live | mock (no Vertex credentials needed)
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_SMART_MODEL=gemini-2.5-pro
RECRUITER_NAME="[Your name]"   # outreach sign-off

# Agaxes: protects passport issue/revoke when set (header x-admin-token). Optional ISSUER_PRIVATE_KEY = base64 Ed25519 key.
COUNTERSIGN_ADMIN_TOKEN=

# Outbound email (docs/OUTBOUND.md). Pick Gmail SMTP (sends + replies) or Resend. Nothing is ever emailed to a candidate.
OUTBOUND_TEST_TO=             # required: every outreach email goes here, never to a candidate
SMTP_HOST=                   # smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=               # Gmail app password
RESEND_API_KEY=
MAIL_FROM=                   # default: SMTP_USER, or onboarding@resend.dev for Resend
MAIL_REPLY_TO=               # mailbox that receives replies (default: the IMAP/SMTP login)
IMAP_HOST=                   # default imap.gmail.com when SMTP_HOST is Gmail
AUTO_SEND=                   # 1 = Sourced emails every draft Send Guard clears, during the run
# Company accounts (backend/app/accounts). 0 turns off the one-click demo workspace on /login
DEMO_ACCOUNT=1
# Optional: where accounts.db lives (default backend/data/accounts.db)
ACCOUNTS_DB=
# Base URL used in password-reset links (backend/app/accounts)
PUBLIC_APP_URL=http://localhost:3000
# Alerts (docs/ALERTS.md): approvals, blocks and stops reach the responsible person. Email goes to OUTBOUND_TEST_TO only.
SLACK_WEBHOOK_URL=           # optional: a Slack incoming webhook; alerts post there with Approve / Reject buttons
AGAXES_PUBLIC_URL=http://localhost:3000   # base of the links in alerts (and seals)
ALERT_LINK_HOURS=24          # how long an Approve / Reject link works
ALERT_LINK_SECRET=           # optional: signs the links (default: a random key in backend/data/alert_link.key)
ALERTS_ENABLED=1             # 0 turns alerts off
